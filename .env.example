# Copia in .env e compila. .env resta solo sul PC: non va mai su GitHub.
# In cloud gli stessi valori diventano "Secrets" del repo (Fase 4).

# Apify — solo per leggere i post LinkedIn (piano gratuito: 5 $/mese di crediti)
APIFY_TOKEN=

# GitHub — opzionale in locale (si può usare `gh auth token`); in cloud è automatico
GITHUB_TOKEN=

# Claude — solo per il cloud: token dell'abbonamento Pro generato con `claude setup-token`
# In locale non serve: usa il login di Claude Code.
CLAUDE_CODE_OAUTH_TOKEN=

# Email del report (Fase 3) — Gmail con "Password per le app" (richiede la verifica in 2 passaggi)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
REPORT_TO=

# LinkedIn — API ufficiale "Share on LinkedIn" per Pubblica/Programma (Fase 8)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# App locale
DIGEST_PORT=8787
